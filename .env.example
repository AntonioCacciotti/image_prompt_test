# Required: OpenAI API key (server-side only, never exposed to the browser)
OPENAI_API_KEY=

# Allowed image models, comma-separated; the first is the default in the dropdown
OPENAI_IMAGE_MODELS=gpt-image-2
# Fallback single model, used only if OPENAI_IMAGE_MODELS is empty
# OPENAI_IMAGE_MODEL=gpt-image-2

# Default quality: low | medium | high | auto (the Effort dropdown overrides it)
OPENAI_IMAGE_QUALITY=low

# Output size; both sides must be a multiple of 16
OPENAI_IMAGE_SIZE=1024x1024
